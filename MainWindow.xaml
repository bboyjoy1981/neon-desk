       <local:HudPanel Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ALL VOLUMES / 磁盘阵列" Foreground="#D3A5B8" FontFamily="Consolas" FontSize="12"/><TextBlock x:Name="DriveCount" Text="等待磁盘数据…" Foreground="#FF657A" FontSize="21" Margin="0,12,0,4"/><local:RadarView Height="158" Drives="{Binding ItemsSource,ElementName=DriveTiles}" Motion="{Binding IsChecked,ElementName=MotionToggle}"/><TextBlock x:Name="DiskIoValue" Text="磁盘读写采样中…" Foreground="#C5A5B4" FontSize="11" Margin="0,12,0,0"/></StackPanel></local:HudPanel>
      </Grid>
      <ItemsControl x:Name="DriveTiles" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#21131E" BorderBrush="#633245" BorderThickness="1" CornerRadius="0" Width="204" Padding="14" Margin="0,0,12,12"><StackPanel><Grid><TextBlock Text="{Binding Name,Mode=OneWay}" FontFamily="Consolas" FontSize="22" Foreground="#FF95A7"/><TextBlock Text="LOCAL DRIVE" FontFamily="Consolas" FontSize="9" Foreground="#C09BAF" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding FreeText,Mode=OneWay}" Margin="0,10,0,7"/><ProgressBar Value="{Binding UsedPercent,Mode=OneWay}" Maximum="100" Height="4" Foreground="#FF657A" Background="#4B2235" BorderThickness="0"/><TextBlock Text="{Binding TotalText,Mode=OneWay}" Foreground="#C5A5B4" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Grid Margin="0,0,12,12"><TextBlock Text="APPLICATION FOOTPRINT / 应用占用" FontFamily="Consolas" Foreground="#D3A5B8" FontSize="12"/><TextBlock Text="逻辑体积，可能包含受保护数据" FontSize="11" HorizontalAlignment="Right" Foreground="#C5A5B4"/></Grid>
      <DataGrid x:Name="AppGrid" IsReadOnly="True" Height="290" Margin="0,0,14,14"><DataGrid.Columns><DataGridTextColumn Header="软件" Binding="{Binding Name,Mode=OneWay}" Width="90"/><DataGridTextColumn Header="总占用" Binding="{Binding Size,Mode=OneWay}" Width="110"/><DataGridTextColumn Header="白名单缓存" Binding="{Binding CacheSize,Mode=OneWay}" Width="120"/><DataGridTextColumn Header="保护范围" Binding="{Binding Description,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="读取状态" Binding="{Binding ScanStatus,Mode=OneWay}" Width="130"/></DataGrid.Columns></DataGrid>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="DiskPage" Visibility="Collapsed" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="255"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,14"><StackPanel><TextBlock Text="全盘雷达 · 大目录热区" FontSize="22" FontWeight="Bold" Foreground="#FFB2BE"/><TextBlock Text="所有本地盘符的目录占用排行。这里只查看，不提供整目录删除。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><ComboBox x:Name="DiskFilter" Width="150" Height="31" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="DiskFilter_Changed"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:RadarView Drives="{Binding ItemsSource,ElementName=DriveTiles}" Motion="{Binding IsChecked,ElementName=MotionToggle}" Margin="0,0,22,0"/><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DiskMap"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label,Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="#D9BBC8" FontSize="11" ToolTip="{Binding Path,Mode=OneWay}"/><Border Grid.Column="1" Background="#3D1A2A" Height="12" CornerRadius="3" Margin="8,2,12,0"><Border HorizontalAlignment="Left" Width="{Binding Width,Mode=OneWay}" CornerRadius="3"><Border.Background><LinearGradientBrush><GradientStop Color="#FF657A"/><GradientStop Color="#F24472" Offset="0.72"/><GradientStop Color="#FF657A" Offset="1"/></LinearGradientBrush></Border.Background></Border></Border><TextBlock Grid.Column="2" Text="{Binding Size,Mode=OneWay}" Foreground="#FFBDC7" FontFamily="Consolas" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
     <Grid Grid.Row="2" Margin="0,16,0,12"><TextBlock Text="逻辑体积不等于可清理量；链接、访问失败或扫描上限会标注。" Foreground="#C5A5B4" FontSize="11"/><Button Content="打开选中目录" Click="OpenDisk_Click" HorizontalAlignment="Right" Padding="12,6" Margin="0"/></Grid>
     <DataGrid x:Name="DiskGrid" Grid.Row="3" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="盘符 / 类别" Binding="{Binding App,Mode=OneWay}" Width="145"/><DataGridTextColumn Header="占用" Binding="{Binding Size,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="较上次" Binding="{Binding Change,Mode=OneWay}" Width="110"/><DataGridTextColumn Header="目录路径" Binding="{Binding Path,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="读取状态" Binding="{Binding Status,Mode=OneWay}" Width="145"/></DataGrid.Columns></DataGrid>
    </Grid>
    <Grid x:Name="CleanupPage" Visibility="Collapsed" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14"><TextBlock Text="缓存清理" FontSize="20" FontWeight="Bold" Foreground="#FF657A"/><TextBlock Text="覆盖全部已就绪本地盘的已识别缓存和过期临时文件。软件运行时不可勾选；个人资料与未知大文件不自动删除。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="CacheCategories" SelectionChanged="CategoryChanged" Margin="0,0,12,0"/><DataGrid x:Name="CacheGrid" Grid.Column="1" SelectionChanged="Cache_SelectionChanged"><DataGrid.Columns>
      <DataGridTemplateColumn Header="选择" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selectable,Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="盘符" Binding="{Binding Drive,Mode=OneWay}" Width="55" IsReadOnly="True"/><DataGridTextColumn Header="软件 / 范围" Binding="{Binding App,Mode=OneWay}" Width="105" IsReadOnly="True"/><DataGridTextColumn Header="类别" Binding="{Binding Name,Mode=OneWay}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="可清理" Binding="{Binding Size,Mode=OneWay}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="文件数" Binding="{Binding FileCount,Mode=OneWay}" Width="65" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Mode=OneWay}" Width="135" IsReadOnly="True"/><DataGridTextColumn Header="具体路径" Binding="{Binding Path,Mode=OneWay}" Width="*" MinWidth="160" IsReadOnly="True"/>
     </DataGrid.Columns></DataGrid>
     </Grid><StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="SelectionSummary" Text="尚未选择清理项目" Foreground="#FFB2BE" FontSize="16" Margin="0,0,0,10"/><TextBlock x:Name="CachePath" Text="选择一行可查看完整路径。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><Button Content="勾选当前分类可清理项" Click="SelectAll_Click"/><Button Content="取消全部勾选" Click="SelectNone_Click"/><Button Content="打开选中目录" Click="OpenCache_Click"/><Button x:Name="CleanButton" Content="清理已勾选缓存" Click="Clean_Click" Background="{StaticResource CircuitTexture}" Foreground="#FFE0E7" BorderBrush="#FF8599"/></WrapPanel></StackPanel>
    </Grid>
    <Grid x:Name="GrowthPage" Visibility="Collapsed" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14"><TextBlock Text="找到悄悄增长的占用" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="BaselineText" Text="首次扫描建立基线；再次扫描后显示变化。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
     <DataGrid x:Name="GrowthGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="软件" Binding="{Binding Name,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="当前占用" Binding="{Binding Size,Mode=OneWay}" Width="150"/><DataGridTextColumn Header="相较上次" Binding="{Binding Change,Mode=OneWay}" Width="150"/><DataGridTextColumn Header="趋势" Binding="{Binding Direction,Mode=OneWay}" Width="150"/></DataGrid.Columns></DataGrid>
     <Grid Grid.Row="2" Margin="0,18,0,12"><TextBlock Text="各软件根目录占用 · 不提供整目录删除" Foreground="#D3A5B8"/><Button Content="打开目录" Click="OpenRoot_Click" HorizontalAlignment="Right" Padding="12,6" Margin="0"/></Grid>
     <DataGrid x:Name="RootGrid" Grid.Row="3" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="软件" Binding="{Binding App,Mode=OneWay}" Width="75"/><DataGridTextColumn Header="占用" Binding="{Binding Size,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="较上次" Binding="{Binding Change,Mode=OneWay}" Width="110"/><DataGridTextColumn Header="目录" Binding="{Binding Path,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Mode=OneWay}" Width="135"/></DataGrid.Columns></DataGrid>
    </Grid>
    <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><TextBlock Text="清理历史与执行轨迹" FontSize="20" FontWeight="Bold"/><Button Content="查看内存占用排行" Click="Processes_Click" HorizontalAlignment="Right" Padding="12,6" Margin="0"/></Grid>
     <DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time,StringFormat=yyyy-MM-dd HH:mm,Mode=OneWay}" Width="170"/><DataGridTextColumn Header="删除文件" Binding="{Binding Deleted,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="跳过" Binding="{Binding Skipped,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="缓存字节数" Binding="{Binding Bytes,StringFormat=N0,Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="2" Text="执行日志（最多 200 条；不保存文件内容）" Foreground="{StaticResource Muted}" Margin="0,16,0,12"/>
     <TextBox x:Name="EventLog" Grid.Row="3" IsReadOnly="True" Background="#140C13" Foreground="#E4B2C3" BorderBrush="#25364D" Padding="14" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </Grid>
   <TextBlock Grid.Row="3" x:Name="Footer" Text="SYSTEM READY  /  缓存有边界，空间看得见。" Foreground="#B99BA9" FontSize="10" FontFamily="Consolas" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
 </DockPanel>
 </Grid>
</Window>











