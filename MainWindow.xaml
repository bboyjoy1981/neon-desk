<StackPanel Orientation="Horizontal"><Path Data="M3,2 L14,2 19,7 19,15 M14,2 L14,7 19,7 M3,2 L3,22 13,22 M18,14 A4,4 0 1 0 18,22 A4,4 0 1 0 18,14 M21,21 L24,24" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,14,0"/><TextBlock Text="大文件查找" VerticalAlignment="Center"/></StackPanel></Button><Button  Style="{StaticResource NavAction}" Click="Duplicates_Click"><StackPanel Orientation="Horizontal"><Path Data="M8,2 L21,2 21,16 17,16 M3,7 L16,7 16,22 3,22 Z" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,14,0"/><TextBlock Text="重复文件分析" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="系统管理" Style="{StaticResource NavGroup}" Margin="12,24,0,8"/><Button  Style="{StaticResource NavAction}" Click="InstalledApps_Click"><StackPanel Orientation="Horizontal"><Path Data="M2,2 L9,2 9,9 2,9 Z M15,2 L22,2 22,9 15,9 Z M2,15 L9,15 9,22 2,22 Z M15,15 L22,15 22,22 15,22 Z" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,14,0"/><TextBlock Text="软件管理" VerticalAlignment="Center"/></StackPanel></Button><Button  Style="{StaticResource NavAction}" Click="StartupApps_Click"><StackPanel Orientation="Horizontal"><Path Data="M12,2 L12,12 M6,5 A10,10 0 1 0 18,5" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,14,0"/><TextBlock Text="启动项管理" VerticalAlignment="Center"/></StackPanel></Button><RadioButton x:Name="NavLogs" GroupName="Pages" Style="{StaticResource NavItem}" Click="LogsPage_Click"><StackPanel Orientation="Horizontal"><Path Data="M5,2 L20,2 20,22 5,22 Z M9,7 L16,7 M9,12 L16,12 M9,17 L14,17" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Margin="0,0,14,0"/><TextBlock Text="执行记录" VerticalAlignment="Center"/></StackPanel></RadioButton></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="10,20,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#FF657A" Margin="0,0,8,0"/><TextBlock Text="本地处理 · 保护个人资料" Foreground="#C7AAB7" FontSize="11"/></StackPanel><CheckBox x:Name="MotionToggle" Content="动态光效" IsChecked="True" Checked="Motion_Changed" Unchecked="Motion_Changed" FontSize="12" Margin="0,15,0,0"/><TextBlock Text="NEON / 0.5.4" FontFamily="Consolas" FontSize="10" Foreground="#B99BA9" Margin="0,14,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,26,20,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22">
    <StackPanel><TextBlock x:Name="PageTitle" Text="实时概览" FontSize="30" FontWeight="Bold" Margin="0,0,0,7"><TextBlock.Effect><DropShadowEffect Color="#FF5269" ShadowDepth="0" BlurRadius="12" Opacity="0.4"/></TextBlock.Effect></TextBlock><TextBlock Text="监测系统状态，找回磁盘空间。" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
    <TextBlock x:Name="Clock" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Consolas" FontSize="13" Foreground="#C7AAB7"/>
