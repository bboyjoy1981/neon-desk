   <Border Grid.Row="1" Background="#21131E" BorderBrush="#633245" BorderThickness="1" CornerRadius="0" Margin="0,0,10,18" Padding="14,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="Activity" Text="雷达待命。自动发现所有已就绪的本地盘符。" Foreground="#FFD0D8" TextWrapping="Wrap"/><TextBlock x:Name="ScanDetail" Text="包含固定硬盘和已插入U盘；不扫描网络盘，不自动删除个人资料。" FontSize="11" Foreground="#C5A5B4" Margin="0,5,0,0"/><ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="3" Foreground="#FF657A" Background="#4B2235" BorderThickness="0" Visibility="Collapsed" Margin="0,9,16,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="启动全盘扫描  →" Click="Scan_Click" Background="{StaticResource CircuitTexture}" Foreground="#FFE0E7" BorderBrush="#FF8599"/><Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel_Click" Margin="0"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <local:HudPanel Style="{StaticResource Card}" BorderBrush="#994659" Padding="12" Margin="0,0,14,16">
       <local:HudPanel.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#281521"/><GradientStop Color="#1B101B" Offset="0.7"/><GradientStop Color="#341520" Offset="1"/></LinearGradientBrush></local:HudPanel.Background>
       <Grid Height="160" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
        <Grid Width="154" Height="154">
         <Ellipse x:Name="CoreHalo" Stroke="#F0365B" StrokeThickness="15" Opacity="0.35" Width="116" Height="116"><Ellipse.Effect><BlurEffect Radius="15"/></Ellipse.Effect></Ellipse>
         <Ellipse Width="142" Height="142" Stroke="#FF657A" StrokeThickness="2" StrokeDashArray="12,3,2,3" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform x:Name="OrbitSpin"/></Ellipse.RenderTransform></Ellipse>
         <Ellipse Width="118" Height="118" Stroke="#FF657A" StrokeThickness="3" StrokeDashArray="2,8,16,8" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform x:Name="InnerSpin"/></Ellipse.RenderTransform></Ellipse>
         <Ellipse Width="152" Height="152" Stroke="#9F3C58" StrokeThickness="5" StrokeDashArray="0.4,3.6"/><Ellipse Width="130" Height="130" Stroke="#A73854" StrokeThickness="1"/><Ellipse Width="97" Height="97" Stroke="#733044" StrokeThickness="1"/>
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="CPU CORE" FontFamily="Consolas" FontSize="9" Foreground="#D89AA9" HorizontalAlignment="Center"/><TextBlock x:Name="CoreValue" Text="—" FontSize="30" FontWeight="Bold" Foreground="#FFE0DF" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="实时系统监测" FontFamily="Consolas" Foreground="#FF9EAC" FontSize="12"/><TextBlock Text="系统运行，一目了然。" FontSize="23" FontWeight="Bold" Margin="0,9,0,10"/><TextBlock x:Name="VolumeSummary" Text="正在识别磁盘阵列…" Foreground="#DFAFBB" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="扫描只读元数据 · 清理须确认" Foreground="#C5A5B4" FontSize="11" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"><TextBlock Text="DETECTED CACHE" FontFamily="Consolas" Foreground="#94A8C8" FontSize="11"/><TextBlock x:Name="CacheTotal" Text="待扫描" FontSize="31" FontWeight="Bold" Foreground="#FF657A" Margin="0,6,0,8"/><TextBlock Text="仅白名单可清理文件" Foreground="#C7AAB7" FontSize="11"/></StackPanel>
        <Rectangle Grid.ColumnSpan="3" Width="220" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.1"><Rectangle.Fill><LinearGradientBrush><GradientStop Color="Transparent"/><GradientStop Color="#FF8594" Offset="0.5"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill><Rectangle.RenderTransform><TranslateTransform x:Name="HeroSweep" X="-220"/></Rectangle.RenderTransform></Rectangle>
       </Grid>
      </local:HudPanel>
      <UniformGrid Columns="4">
       <local:HudPanel Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M5,5 L19,5 19,19 5,19 Z M9,9 L15,9 15,15 9,15 Z M8,1 L8,5 M16,1 L16,5 M8,19 L8,23 M16,19 L16,23 M1,8 L5,8 M1,16 L5,16 M19,8 L23,8 M19,16 L23,16" Width="19" Height="19" Stretch="Uniform" Stroke="#FF8398" StrokeThickness="1.3" Margin="0,0,9,0"/><TextBlock Text="CPU / 使用率" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="CpuValue" Text="—" Foreground="#FF657A" FontSize="33" FontWeight="Bold" Margin="0,12,0,12"/><ProgressBar x:Name="CpuBar" Height="4" Maximum="100" Background="#4B2235" Foreground="#FF657A" BorderThickness="0"/><TextBlock Text="每 2 秒刷新" Foreground="#C5A5B4" FontSize="11" Margin="0,12,0,0"/></StackPanel></local:HudPanel>
       <local:HudPanel Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M2,5 L22,5 22,18 2,18 Z M6,9 L9,9 9,14 6,14 Z M14,9 L17,9 17,14 14,14 Z M5,18 L5,22 M10,18 L10,22 M15,18 L15,22 M20,18 L20,22" Width="19" Height="19" Stretch="Uniform" Stroke="#FF8398" StrokeThickness="1.3" Margin="0,0,9,0"/><TextBlock Text="MEMORY / 物理内存" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="MemoryValue" Text="—" Foreground="#FF657A" FontSize="33" FontWeight="Bold" Margin="0,12,0,12"/><ProgressBar x:Name="MemoryBar" Height="4" Maximum="100" Background="#4B2235" Foreground="#FF657A" BorderThickness="0"/><TextBlock Text="不强制压缩或清空内存" Foreground="#C5A5B4" FontSize="11" Margin="0,12,0,0"/></StackPanel></local:HudPanel>
       <local:HudPanel Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M2,3 L22,3 22,17 2,17 Z M7,22 L17,22 M12,17 L12,22 M8,7 L16,7 16,13 8,13 Z" Width="19" Height="19" Stretch="Uniform" Stroke="#FF8398" StrokeThickness="1.3" Margin="0,0,9,0"/><TextBlock Text="GPU / 引擎峰值" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="GpuValue" Text="—" Foreground="#FFA18D" FontSize="33" FontWeight="Bold" Margin="0,12,0,12"/><ProgressBar x:Name="GpuBar" Height="4" Maximum="100" Background="#4B2235" Foreground="#FFA18D" BorderThickness="0"/><TextBlock x:Name="GpuDetail" Text="等待驱动计数器" Foreground="#C5A5B4" FontSize="11" Margin="0,12,0,0"/></StackPanel></local:HudPanel>
       <local:HudPanel Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="M2,2 L9,2 9,8 2,8 Z M15,16 L22,16 22,22 15,22 Z M5,8 L5,18 15,18 M18,16 L18,5 9,5" Width="19" Height="19" Stretch="Uniform" Stroke="#FF8398" StrokeThickness="1.3" Margin="0,0,9,0"/><TextBlock Text="NETWORK / 物理网卡" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="DownloadValue" Text="—" Foreground="#FFA6BE" FontSize="23" FontWeight="Bold" Margin="0,18,0,10"/><TextBlock x:Name="UploadValue" Text="↑ —" Foreground="#D5A7B9" FontSize="12"/><TextBlock Text="实时速率 · 非网络测速" Foreground="#C5A5B4" FontSize="11" Margin="0,16,0,0"/></StackPanel></local:HudPanel>
      </UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
